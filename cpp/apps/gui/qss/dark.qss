QMainWindow, QDialog, QWidget {
  background-color: #1c1c1e;
  color: #f5f5f7;
}
QListView#ContactList {
  background: #2c2c2e;
  border: none;
  padding: 8px;
  outline: none;
}
QListView#ContactList::item {
  padding: 10px 12px;
  border-radius: 10px;
}
QListView#ContactList::item:selected {
  background: #0a84ff;
  color: #ffffff;
}
QListView#ChatView {
  background: #1c1c1e;
  border: none;
  outline: none;
}
QLineEdit#Composer {
  background: #2c2c2e;
  border: 1px solid #3a3a3c;
  border-radius: 12px;
  padding: 10px 14px;
  color: #f5f5f7;
  min-height: 22px;
}
QLineEdit#Composer:focus { border: 1px solid #0a84ff; }
QPushButton {
  background-color: #3a3a3c;
  border: none;
  border-radius: 8px;
  padding: 8px 16px;
  color: #f5f5f7;
}
QPushButton:hover { background-color: #48484a; }
QPushButton#PrimaryButton { background-color: #0a84ff; color: #ffffff; }
QPushButton#PrimaryButton:hover { background-color: #0077ed; }
QLabel#StatusBar {
  color: #8e8e93;
  font-size: 12px;
  padding: 4px 12px;
}
QMenuBar { background: #1c1c1e; color: #f5f5f7; }
QMenu { background: #2c2c2e; color: #f5f5f7; border-radius: 8px; }
QScrollBar:vertical { width: 10px; background: transparent; }
QScrollBar::handle:vertical { background: #48484a; border-radius: 4px; min-height: 24px; }
